<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <!-- 继承父的配置参数-->
    <parent>
        <groupId>io.github.xbstar</groupId>
        <artifactId>project</artifactId>
        <version>1.1.1</version>
    </parent>
    <!-- 配置应用参数-->
    <modelVersion>4.0.0</modelVersion>
    <groupId>io.github.xbstar</groupId>
    <artifactId>flink</artifactId>
    <version>1.16.2</version>
    <packaging>pom</packaging>
    <name>flink</name>
    <description>Flink项目模板</description>
    <url>https://github.com/xbstar/project</url>

    <!-- flink-1.16.2项目-->
    <properties>
        <java.version>1.8</java.version>
        <maven.compiler.source>${java.version}</maven.compiler.source>
        <maven.compiler.target>${java.version}</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <flink.main>${project.groupId}.${project.artifactId}.Main</flink.main>
    </properties>
    <dependencies>
        <!-- 依赖卷心菜框架-->
        <dependency>
            <groupId>com.xbstar</groupId>
            <artifactId>xbstar-cabbage</artifactId>
            <version>1.1.1</version>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>XBX152</id>
            <url>http://223.112.44.146:9999/repository/MAVEN/</url>
        </repository>
    </repositories><!-- 配置西北星私服，这样才能下载到卷心菜框架-->
    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>3.2.0</version>
                    <configuration>
                        <archive>
                            <manifest>
                                <mainClass>${flink.main}</mainClass>
                                <addDefaultImplementationEntries>true</addDefaultImplementationEntries>
                            </manifest>
                        </archive>
                    </configuration>
                </plugin><!--默认安装 maven-jar-plugin-->
            </plugins>
        </pluginManagement>
    </build>
</project>
