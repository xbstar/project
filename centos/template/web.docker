FROM nginx
MAINTAINER chenguang<cheng@ciotc.org>
#部署应用
WORKDIR /etc/nginx
COPY ./dist /etc/nginx/html/${APPLICATION}
RUN echo '                                                          \n\
server {                                                            \n\
    listen 80;                                                      \n\
    listen [::]:80;                                                 \n\
    server_name localhost;                                          \n\
    gzip on;                                                        \n\
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml text/javascript; \n\
    error_page 500 502 503 504 /50x.html;                           \n\
    location = /50x.html {                                          \n\
        root /usr/share/nginx/html;                                 \n\
    }                                                               \n\
    location / {                                                    \n\
        root /etc/nginx/html/${APPLICATION};                        \n\
        index index.html;                                           \n\
        try_files $uri /index.html;                                 \n\
    }                                                               \n\
    location  ~ ^/([^/]+)/${APPLICATION}/(.*)$ {                    \n\
        rewrite ^/([^/]+)/${APPLICATION}/(.*)$ /$2 last;            \n\
    }                                                               \n\
    location  ~ ^/([^/]+)${APPLICATION}/(.*)$ {                     \n\
        rewrite ^/([^/]+)${APPLICATION}/(.*)$ /$2 last;             \n\
    }                                                               \n\
}' > /etc/nginx/conf.d/default.conf
EXPOSE 80


